            },
            {
              "type": "frame",
              "id": "XRbtv",
              "x": 16,
              "y": 368,
              "name": "script",
              "width": 424,
              "height": 250,
              "fill": "#1C1C1E",
              "cornerRadius": 8,
              "layout": "vertical",
              "gap": 3,
              "padding": [
                10,
                12
              ],
              "children": [
                {
                  "type": "text",
                  "id": "U1B6O",
                  "name": "t",
                  "fill": "#8E8E93",
                  "content": "#!/bin/bash",
                  "fontFamily": "Geist Mono",
                  "fontSize": 9,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "Pu2dd",
                  "name": "t",
                  "fill": "#8E8E93",
                  "content": "#SBATCH --job-name=train_cnnws_M2aug_sep14",
                  "fontFamily": "Geist Mono",
                  "fontSize": 9,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "VKe1x",
                  "name": "t",
                  "fill": "#8E8E93",
                  "content": "#SBATCH --gres=gpu:1  --time=04:00:00",
                  "fontFamily": "Geist Mono",
                  "fontSize": 9,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "c7ki6",
                  "name": "t",
                  "fill": "#8E8E93",
                  "content": "#SBATCH --mem=32G",
                  "fontFamily": "Geist Mono",
                  "fontSize": 9,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "OQhBL",
                  "name": "t",
                  "fill": "#E5E5EA",
                  "content": " ",
                  "fontFamily": "Geist Mono",
                  "fontSize": 9,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "mqk2w",
                  "name": "t",
                  "fill": "#E5E5EA",
                  "content": "python -m pipeline.train \\",
                  "fontFamily": "Geist Mono",
                  "fontSize": 9,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "j3sz7",
                  "name": "t",
                  "fill": "#E5E5EA",
                  "content": "  --template cnn_windowset_v1@1 \\",
                  "fontFamily": "Geist Mono",
                  "fontSize": 9,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "upEUm",
                  "name": "t",
                  "fill": "#E5E5EA",
                  "content": "  --windowset ws_M2aug_3ch_600s@1 \\",
                  "fontFamily": "Geist Mono",
                  "fontSize": 9,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "MTIv0",
                  "name": "t",
                  "fill": "#E5E5EA",
                  "content": "  --arms manual,cluster --baseline rf \\",
                  "fontFamily": "Geist Mono",
                  "fontSize": 9,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "Yy4fr",
                  "name": "t",
                  "fill": "#E5E5EA",
                  "content": "  --paired-windows labelled-in-all \\",
                  "fontFamily": "Geist Mono",
                  "fontSize": 9,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "d1z5L",
                  "name": "t",
                  "fill": "#E5E5EA",
                  "content": "  --split from-windowset \\",
                  "fontFamily": "Geist Mono",
                  "fontSize": 9,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "u8QpY",
                  "name": "t",
                  "fill": "#E5E5EA",
                  "content": "  --null rf:200,model:5 \\",
                  "fontFamily": "Geist Mono",
                  "fontSize": 9,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "y9Z84",
                  "name": "t",
                  "fill": "#E5E5EA",
                  "content": "  --verdicts-as-of launch \\",
                  "fontFamily": "Geist Mono",
                  "fontSize": 9,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "M1QsD0",
                  "name": "t",
                  "fill": "#E5E5EA",
                  "content": "  --manifest inbox/",
                  "fontFamily": "Geist Mono",
                  "fontSize": 9,
                  "fontWeight": "normal"
                }
              ]
            },
