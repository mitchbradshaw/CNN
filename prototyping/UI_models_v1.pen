            {
              "type": "text",
              "id": "LQ7U6",
              "x": 16,
              "y": 346,
              "name": "t",
              "fill": "#000000",
              "content": "SLURM script",
              "fontFamily": "Inter",
              "fontSize": 12,
              "fontWeight": "600"
            },
            {
              "type": "frame",
              "id": "d55F8",
              "x": 16,
              "y": 368,
              "name": "script",
              "width": 424,
              "height": 250,
              "fill": "#1C1C1E",
              "cornerRadius": 8,
              "layout": "vertical",
              "gap": 3,
              "padding": [
                10,
                12
              ],
              "children": [
                {
                  "type": "text",
                  "id": "PrUrq",
                  "name": "t",
                  "fill": "#8E8E93",
                  "content": "#!/bin/bash",
                  "fontFamily": "Geist Mono",
                  "fontSize": 9,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "KZ8BE",
                  "name": "t",
                  "fill": "#8E8E93",
                  "content": "#SBATCH --job-name=train_cnn_M2aug_sep14",
                  "fontFamily": "Geist Mono",
                  "fontSize": 9,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "D2GUyg",
                  "name": "t",
                  "fill": "#8E8E93",
                  "content": "#SBATCH --gres=gpu:1  --time=04:00:00",
                  "fontFamily": "Geist Mono",
                  "fontSize": 9,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "I7zoZo",
                  "name": "t",
                  "fill": "#8E8E93",
                  "content": "#SBATCH --mem=32G",
                  "fontFamily": "Geist Mono",
                  "fontSize": 9,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "XgJwO",
                  "name": "t",
                  "fill": "#E5E5EA",
                  "content": " ",
                  "fontFamily": "Geist Mono",
                  "fontSize": 9,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "p59VBs",
                  "name": "t",
                  "fill": "#E5E5EA",
                  "content": "python -m pipeline.train \\",
                  "fontFamily": "Geist Mono",
                  "fontSize": 9,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "T4r3Wl",
                  "name": "t",
                  "fill": "#E5E5EA",
                  "content": "  --template cnn_windows_v3@3 \\",
                  "fontFamily": "Geist Mono",
                  "fontSize": 9,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "GIpQ5",
                  "name": "t",
                  "fill": "#E5E5EA",
                  "content": "  --sources M2_aug_fs1:CH2_A1,CH4_A2,CH7_B2 \\",
                  "fontFamily": "Geist Mono",
                  "fontSize": 9,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "gbB1D",
                  "name": "t",
                  "fill": "#E5E5EA",
                  "content": "  --arms manual,cluster --baseline rf \\",
                  "fontFamily": "Geist Mono",
                  "fontSize": 9,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "GFmr7",
                  "name": "t",
                  "fill": "#E5E5EA",
                  "content": "  --paired-windows labelled-in-all \\",
                  "fontFamily": "Geist Mono",
                  "fontSize": 9,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "M6ahn",
                  "name": "t",
                  "fill": "#E5E5EA",
                  "content": "  --split blocked:test=0.2,val=0.1,gap=600 \\",
                  "fontFamily": "Geist Mono",
                  "fontSize": 9,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "l9jN8n",
                  "name": "t",
                  "fill": "#E5E5EA",
                  "content": "  --null rf:200,model:5 \\",
                  "fontFamily": "Geist Mono",
                  "fontSize": 9,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "S7lQT",
                  "name": "t",
                  "fill": "#E5E5EA",
                  "content": "  --save-windowset ws_M2aug_3ch_600s_v2 \\",
                  "fontFamily": "Geist Mono",
                  "fontSize": 9,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "Y14EQ",
                  "name": "t",
                  "fill": "#E5E5EA",
                  "content": "  --manifest inbox/",
                  "fontFamily": "Geist Mono",
                  "fontSize": 9,
                  "fontWeight": "normal"
                }
              ]
            },
