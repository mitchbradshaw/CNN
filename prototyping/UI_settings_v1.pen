                      "content": "#!/bin/bash",
                      "fontFamily": "Geist Mono",
                      "fontSize": 10,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "JnmBV",
                      "name": "t",
                      "fill": "#8FB8E8",
                      "content": "#SBATCH --account=a_myco --partition=gpu_short --nodes=1",
                      "fontFamily": "Geist Mono",
                      "fontSize": 10,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "t1YXt",
                      "name": "t",
                      "fill": "#8FB8E8",
                      "content": "#SBATCH --gres=gpu:1 --cpus-per-task=8 --mem=32G --time=04:00:00",
                      "fontFamily": "Geist Mono",
                      "fontSize": 10,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "YXdTx",
                      "name": "t",
                      "fill": "#8FB8E8",
                      "content": "#SBATCH --mail-type=END",
                      "fontFamily": "Geist Mono",
                      "fontSize": 10,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "xY9PA",
                      "name": "t",
                      "fill": "#E5E5EA",
                      "content": "module load cuda/12.1 && conda activate cnn",
                      "fontFamily": "Geist Mono",
                      "fontSize": 10,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "Fiy4s",
                      "name": "t",
                      "fill": "#E5E5EA",
                      "content": "cd /scratch/$USER/cnn",
                      "fontFamily": "Geist Mono",
                      "fontSize": 10,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "wFFbp",
                      "name": "t",
                      "fill": "#E5E5EA",
                      "content": "python -m pipeline.run --recipe {{recipe}} --out /scratch/$USER/cnn/out/{{job}}",
                      "fontFamily": "Geist Mono",
                      "fontSize": 10,
                      "fontWeight": "normal"
                    }
                  ]
                }
